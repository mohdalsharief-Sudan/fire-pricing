{
  "name": "fire-pricing",
  "productName": "نظام التسعير الذكي للحماية من الحرائق",
  "version": "2.4.0",
  "description": "نظام تسعير ذكي لمشاريع توريد وتركيب أنظمة الإطفاء والإنذار من الحريق — بقاعدة بيانات SQLite ومكتبة أجهزة ومواد كاملة",
  "main": "main.js",
  "author": {
    "name": "شركة مقاولات الحماية من الحرائق"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/",
    "seed": "node scripts/generate-seeds.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder",
    "license:keys": "node tools/generate-keys.js",
    "license:gen": "node tools/generate-license.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.firepricing.app",
    "productName": "نظام التسعير الذكي للحماية من الحرائق",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "js/**/*",
      "src/**/*",
      "css/**/*",
      "icons/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/app.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icons/app.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/app.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "2055"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "better-sqlite3@12.11.1": true
  }
}
